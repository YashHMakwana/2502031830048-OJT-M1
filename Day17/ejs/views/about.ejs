<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= Title %></h1>
    <p><%= Message %></p>

    <!-- <% %> -->

    <ul>
        <% items.forEach(function(item){ %>
            <li><%= item %></li>
        <% }); %>
    </ul>
    <table border="1">
        <% user.forEach(function(u){%>
            <tr>
                <td><%= u.name %></td>
                <td><%= u.age %></td>
                <td><%= u.city %></td>
            </tr>
        <% }); %>
    </table>
</body>
</html>